# ══════════════════════════════════════════════════════════════════════════════
# manager-side — Environment Variables
# Copy this file to manager-side/.env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-string   # Session signing key
FLASK_PORT=5001
FLASK_DEBUG=true

# ── Manager login credentials ─────────────────────────────────────────────────
MANAGER_USERNAME=admin
MANAGER_PASSWORD=change_me    # Change this — must match FLASK_PASSWORD in hartnell-trainer/.env

# ── DynamoDB ──────────────────────────────────────────────────────────────────
PROGRESS_TABLE_NAME=canvas-ai-trainer-module-progress
AWS_REGION=us-west-2
# AWS credentials — set via AWS_PROFILE or explicit keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
