# ══════════════════════════════════════════════════════════════════════════════
# Hartnell AI Trainer — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2                # AWS region for S3 and DynamoDB
AWS_ACCESS_KEY_ID=                  # IAM access key (for local dev only — Lambda uses IAM roles)
AWS_SECRET_ACCESS_KEY=              # IAM secret key (for local dev only)
S3_BUCKET_NAME=                     # S3 bucket for training materials (e.g. hartnell-trainer-assets-123456)

# ── AI / Chat (Panther Assistant) ────────────────────────────────────────────
# Currently using OpenAI. May switch to AWS Bedrock — confirm with team.
OPENAI_API_KEY=                     # OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_MODEL=gpt-4o-mini           # Model ID (gpt-4o-mini, gpt-4o, etc.)

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000                           # Express server port
NODE_ENV=development                # development | production

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                         # Secret for signing tokens (any random string for dev)

# ── Manager Dashboard (Flask proxy) ─────────────────────────────────────────
FLASK_BASE_URL=http://localhost:5001  # URL where Khanh's Flask manager-side app runs
FLASK_USERNAME=                       # Flask login username for manager dashboard
FLASK_PASSWORD=                       # Flask login password for manager dashboard
