# ══════════════════════════════════════════════════════════════════════════════
# Hartnell AI Trainer — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── AWS credentials (local dev only — Lambda/EC2 use IAM roles in prod) ───────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 — curated training content bucket (used by training.js) ───────────────
# Stores hand-curated lesson JSON + video/image assets.
# Folder layout: modules/<moduleId>/lesson.json, modules/<moduleId>/<asset>
S3_BUCKET_NAME=

# ── S3 — admin upload / AI generation bucket (used by upload.js) ─────────────
# Files uploaded by admins land in raw/ here.
# The module_generator Lambda reads raw/ and writes processed/ JSON.
# If left blank, the app falls back to local disk + OpenAI for generation.
PREPROD_BUCKET=canvas-ai-trainer-preprod-807462092040

# ── AWS API Gateway — Amir's deployed Lambdas ─────────────────────────────────
# Handles: /api/progress/update, /api/progress/:userId,
#          /api/auth/login, /ask (chat), /upload-url, /generate-module, /modules
AWS_API_BASE=https://yhpt0ck7c7.execute-api.us-west-2.amazonaws.com

# ── Admin upload / module generation Lambda endpoints ─────────────────────────
# Set this to AWS_API_BASE if the preprod Lambdas are deployed under the same
# API Gateway, or to a separate stage URL if they live elsewhere.
# Leave blank to fall back to local disk + OpenAI generation.
PREPROD_API_BASE=

# ── OpenAI (local-dev fallback for module generation) ────────────────────────
# Only used when PREPROD_API_BASE is not set.
# Allows the team to test the upload pipeline locally without AWS credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── DynamoDB — shared progress table ─────────────────────────────────────────
PROGRESS_TABLE_NAME=canvas-ai-trainer-module-progress

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Manager Dashboard — Flask proxy ──────────────────────────────────────────
# The Node server proxies /api/manager/* to Khanh's Flask app on :5001.
# Run: cd manager-side && python app.py
FLASK_BASE_URL=http://localhost:5001
FLASK_USERNAME=
FLASK_PASSWORD=
