# ══════════════════════════════════════════════════════════════════════════════
# Hartnell AI Trainer — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── AWS (used by training.js and upload.js for S3 access) ────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=          # IAM key for local dev only — Lambda uses IAM roles
AWS_SECRET_ACCESS_KEY=      # IAM secret for local dev only
S3_BUCKET_NAME=             # e.g. hartnell-trainer-assets-123456

# ── AWS API Gateway (progress + chat Lambdas — Amir's endpoints) ─────────────
AWS_API_BASE=https://yhpt0ck7c7.execute-api.us-west-2.amazonaws.com

# ── DynamoDB (shared table — used by Flask app and Lambda) ───────────────────
PROGRESS_TABLE_NAME=canvas-ai-trainer-module-progress

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=             # Any random string for dev; use a strong secret in prod

# ── Manager Dashboard (Flask proxy) ──────────────────────────────────────────
FLASK_BASE_URL=http://localhost:5001   # Where manager-side/app.py listens
FLASK_USERNAME=                        # Must match MANAGER_USERNAME in manager-side/.env
FLASK_PASSWORD=                        # Must match MANAGER_PASSWORD in manager-side/.env
